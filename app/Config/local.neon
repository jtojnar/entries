php:
	date.timezone: Europe/Prague

services:
	exchange: Money\Exchange\ReversedCurrenciesExchange(
		Money\Exchange\FixedExchange([
			'EUR': [
				'CZK': '25'
			]
		])
	)


parameters:
	siteTitle:
		cs: 3. Kočkogaining 2026
		en: Black Cat Cup 2026
	webmasterEmail: jan.tojnar@rogaining.cz
	accountNumber: '523144003/5500'
	entries:
		minMembers: 2
		maxMembers: 2
		recommendedCardCapacity: 30
		eventDate: 2026-10-17 # used for age calculations
		invoiceModifier: App\Config\CustomInvoiceModifier
		opening: 2026-08-09T00:00:00
		closing: 2026-10-07T12:00:00
		fees:
			currency: CZK
			person: 0
		limits:
			postel: 73
		categories:
			MJ:
				constraints:
					- 'all(gender=male)'
					- 'all(age<=18)'
			WJ:
				constraints:
					- 'all(gender=female)'
					- 'all(age<=18)'
			XJ:
				constraints:
					- 'some(gender=male)'
					- 'some(gender=female)'
					- 'all(age<=18)'
			MO:
				constraints:
					- 'all(gender=male)'
			XO:
				constraints:
					- 'some(gender=male)'
					- 'some(gender=female)'
			WO:
				constraints:
					- 'all(gender=female)'
			MV:
				constraints:
					- 'all(gender=male)'
					- 'all(age>=45)'
			XV:
				constraints:
					- 'some(gender=male)'
					- 'some(gender=female)'
					- 'all(age>=45)'
			WV:
				constraints:
					- 'all(gender=female)'
					- 'all(age>=45)'
			C:
				constraints:
		fields:
			team:
				sportident:
					type: sportident
					fee: 70
				saturday5h:
					type: enum
					label:
						en: '5-hour Saturday:'
						cs: 'Sobotní pětihodinovka:'
					options:
						yes:
							label:
								en: 'Yes'
								cs: 'Ano'
							fee: 200
						no:
							label:
								en: 'No'
								cs: 'Ne'
							default: true
				sunday4h:
					type: enum
					label:
						en: '4-hour Sunday:'
						cs: 'Nedělní čtyřhodinovka:'
					options:
						yes:
							label:
								en: 'Yes'
								cs: 'Ano'
							fee: 200
						no:
							label:
								en: 'No'
								cs: 'Ne'
							default: true
			person:
				country:
					type: country
					default: 46
					public: true
				accommodation:
					label:
						en: 'Accommodation must be ordered and paid until Wednesday October 7, 2026'
						cs: 'Ubytování se musí objednat a zaplatit do středy 7. 10. 2026'
					type: enum
					options:
						postel-Pa-So:
							label:
								en: 'A bed in a 2-5-bed room, Friday through Saturday, with duvet and bedding, shared bathroom facilities, 300 Kč per person.'
								cs: 'Postel ve 2-5 lůžkovém pokoji, pátek až sobota, s lůžkovinami, společné soc. zař., 300 Kč/os.'
							fee: 300
							limit: postel
						postel-So-Ne:
							label:
								en: 'A bed in a 2-5-bed room, Saturday through Sunday, with duvet and bedding, shared bathroom facilities, 300 Kč per person.'
								cs: 'Postel ve 2-5 lůžkovém pokoji, sobota až neděle, s lůžkovinami, společné soc. zař., 300 Kč/os.'
							fee: 300
							limit: postel
						postel-Pa-Ne:
							label:
								en: 'A bed in a 2-5-bed room, Friday through Sunday, with duvet and bedding, shared bathroom facilities, 600 Kč per person.'
								cs: 'Postel ve 2-5 lůžkovém pokoji, pátek až neděle, s lůžkovinami, společné soc. zař., 600 Kč/os.'
							fee: 600
							limit: postel
						matracenazemi-Pa-So:
							label:
								en: 'Mattresses on the floor in the classroom, Friday through Saturday, in own sleeping bag, 130 Kč per person.'
								cs: 'Matrace ve třídě na zemi, pátek až sobota, ve vlastním spacím pytli, 130 Kč/os.'
							fee: 130
						matracenazemi-So-Ne:
							label:
								en: 'Mattresses on the floor in the classroom, Saturday through Sunday, in own sleeping bag, 130 Kč per person.'
								cs: 'Matrace ve třídě na zemi, sobota až neděle, ve vlastním spacím pytli, 130 Kč/os.'
							fee: 130
						matracenazemi-Pa-Ne:
							label:
								en: 'Mattresses on the floor in the classroom, Friday through Sunday, in own sleeping bag, 260 Kč per person.'
								cs: 'Matrace ve třídě na zemi, pátek až neděle, ve vlastním spacím pytli, 260 Kč/os.'
							fee: 260
						karimatkanazemi-Pa-So:
							label:
								en: 'On your own sleeping pad on the floor in the classroom, Friday through Saturday, in own sleeping bag, 100 Kč per person.'
								cs: 'Na vlastní karimatce ve třídě na zemi, pátek až sobota, ve vlastním spacím pytli, 100 Kč/os.'
							fee: 100
						karimatkanazemi-So-Ne:
							label:
								en: 'On your own sleeping pad on the floor in the classroom, Saturday through Sunday, in own sleeping bag, 100 Kč per person.'
								cs: 'Na vlastní karimatce ve třídě na zemi, sobota až neděle, ve vlastním spacím pytli, 100 Kč/os.'
							fee: 100
						karimatkanazemi-Pa-Ne:
							label:
								en: 'On your own sleeping pad on the floor in the classroom, Friday through Sunday, in own sleeping bag, 260 Kč per person.'
								cs: 'Na vlastní karimatce ve třídě na zemi, pátek až neděle, ve vlastním spacím pytli, 200 Kč/os.'
							fee: 200
						none:
							default: true
							label:
								en: 'None'
								cs: 'Žádné'
							fee: 0
				boarding:
					label:
						en: 'Boarding must be ordered and paid until Wednesday October 7, 2026'
						cs: 'Stravování se musí objednat a zaplatit do středy 7. 10. 2026'
					type: checkboxlist
					items:
						sat-breakfast:
							label:
								en: 'Saturday breakfast, buffet (90 CZK)'
								cs: 'Sobotní snídaně, bufetová (90 Kč)'
							fee: 90
						sat-goulash:
							label:
								en: 'Saturday supper – soup, beef goulash with dumplings (135 Kč)'
								cs: 'Sobotní večeře – polévka, hovězí guláš s knedlíkem (135 Kč)'
							fee: 165
						sat-hli-goulash:
							label:
								en: 'Saturday supper – soup, oyster mushrooms goulash, with dumplings (135 Kč)'
								cs: 'Sobotní večeře – polévka, hlívový guláš s knedlíkem (135 Kč)'
							fee: 135
						sun-breakfast:
							label:
								en: 'Sunday breakfast, buffet (90 CZK)'
								cs: 'Nedělní snídaně, bufetová (90 Kč)'
							fee: 90
						sun-schnitzel:
							label:
								en: 'Sunday after race meal – soup + schnitzel with potato salad (135 CZK)'
								cs: 'Nedělní pozávodní jídlo – polévka a řízek s bramborovým salátem (135 Kč)'
							fee: 135
						sun-cheese:
							label:
								en: 'Sunday after race meal – soup + fried cheese with potatoes (135 CZK)'
								cs: 'Nedělní pozávodní jídlo – polévka a smažený sýr s bramborami (135 Kč)'
							fee: 135
